<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.Student.StudentAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,24" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Account Settings" Style="{StaticResource TitleTextBlockStyle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="View your student profile information and manage your account security credentials."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Card 1: Registration Profile -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Registration Profile" FontSize="16" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Student ID Number" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.StudentNo, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Student ID Number" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Full Name" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.FullName, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Full Name" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Username" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Username, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Username" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Account Status" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.AccountStatus, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Account Status" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Email Address" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Email, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Email Address" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Phone Number" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Phone, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Phone Number" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: ID Submission Profile Data -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="ID Information Profile" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Values remain blank until you complete and submit your ID Generator form."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Gender" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Gender, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Gender" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Birth Date" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.BirthDate, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Birth Date" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <TextBlock Text="Age" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Age, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Age" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Year &amp; Section" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.YearAndSection, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Year and Section" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                            <TextBlock Text="Section Adviser" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Adviser, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Section Adviser" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock Text="Complete Address" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.Address, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Complete Address" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Guardian / Parent Name" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.GuardianName, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Guardian Name" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Guardian Phone" FontWeight="Medium" />
                            <TextBox Text="{x:Bind ViewModel.GuardianPhone, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="Guardian Phone" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Change Password -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Change Password" FontSize="16" FontWeight="SemiBold" />

                    <!-- Status InfoBar -->
                    <InfoBar IsOpen="{x:Bind ViewModel.PasswordStatusMessage.Length, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}"
                             Severity="{x:Bind ViewModel.PasswordStatusSeverity, Mode=OneWay}"
                             Message="{x:Bind ViewModel.PasswordStatusMessage, Mode=OneWay}"
                             IsClosable="False" />

                    <!-- Current Password -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Current Password" FontWeight="Medium" />
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     PasswordChanged="CurrentPasswordBox_PasswordChanged"
                                     AutomationProperties.Name="Current Password" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentPasswordError, Mode=OneWay}" Foreground="Red" FontSize="12"
                                   Visibility="{x:Bind ViewModel.CurrentPasswordError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- New Password -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="New Password (min 8 characters)" FontWeight="Medium" />
                        <PasswordBox x:Name="NewPasswordBox"
                                     PasswordChanged="NewPasswordBox_PasswordChanged"
                                     AutomationProperties.Name="New Password" />
                        <TextBlock Text="{x:Bind ViewModel.NewPasswordError, Mode=OneWay}" Foreground="Red" FontSize="12"
                                   Visibility="{x:Bind ViewModel.NewPasswordError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Confirm Password -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Confirm New Password" FontWeight="Medium" />
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                     AutomationProperties.Name="Confirm New Password" />
                        <TextBlock Text="{x:Bind ViewModel.ConfirmPasswordError, Mode=OneWay}" Foreground="Red" FontSize="12"
                                   Visibility="{x:Bind ViewModel.ConfirmPasswordError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Button Content="Update Password"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Command="{x:Bind ViewModel.ChangePasswordCommand}"
                            AutomationProperties.Name="Update Password" />
                </StackPanel>
            </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
