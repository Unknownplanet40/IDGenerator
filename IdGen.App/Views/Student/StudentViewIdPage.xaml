<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.Student.StudentViewIdPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:IdGen.App.Controls"
    xmlns:vm="using:IdGen.App.ViewModels.Student"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,24,32,32" HorizontalAlignment="Stretch">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="View Student ID" Style="{StaticResource TitleTextBlockStyle}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Preview your official CR80 front and back student identification card rendered from the institutional layout template."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- No Submission Placeholder -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="40"
                        Visibility="{x:Bind ViewModel.HasSubmission, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No ID Submission Found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="You have not submitted your student ID details yet. Please visit the ID Generator tab to fill out and submit your form."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="450" />
                    </StackPanel>
                </Border>

                <!-- Submission Active View -->
                <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.HasSubmission, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Status Badge InfoBar -->
                    <InfoBar IsOpen="True"
                             Severity="{x:Bind ViewModel.StatusBadgeSeverity, Mode=OneWay}"
                             Title="ID Status:"
                             Message="{x:Bind ViewModel.StatusBadgeText, Mode=OneWay}"
                             IsClosable="False" />

                    <!-- CR80 Dynamic Card Previews -->
                    <StackPanel Spacing="20">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Official Card Previews (CR80 Standard)" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Physical dimension: 85.6 mm × 54.0 mm @ 300 DPI. Ready for ID card printers (Zebra, Fargo, Evolis) and paper printers."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="PrintCardButton"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Click="PrintCardButton_Click"
                                            IsEnabled="{x:Bind ViewModel.IsApproved, Mode=OneWay}"
                                            AutomationProperties.Name="Print or Export ID Card Button">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE749;" FontSize="14" />
                                            <TextBlock Text="Print / Export ID Card" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="32" RowSpacing="32" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- FRONT CARD -->
                            <StackPanel Grid.Column="0" Spacing="10">
                                <TextBlock Text="Front Card" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="#94A3B8"
                                        Background="White">
                                    <Viewbox Width="{x:Bind GetCardDisplayWidth(ViewModel.CanvasWidth), Mode=OneWay}"
                                             Height="{x:Bind GetCardDisplayHeight(ViewModel.CanvasHeight), Mode=OneWay}"
                                             Stretch="Uniform">
                                        <Canvas x:Name="FrontCanvas"
                                                Width="{x:Bind ViewModel.CanvasWidth, Mode=OneWay}"
                                                Height="{x:Bind ViewModel.CanvasHeight, Mode=OneWay}">
                                            <!-- Front Background -->
                                            <Border x:Name="FrontBackgroundBorder"
                                                    Width="{x:Bind ViewModel.CanvasWidth, Mode=OneWay}"
                                                    Height="{x:Bind ViewModel.CanvasHeight, Mode=OneWay}"
                                                    Background="{x:Bind ViewModel.FrontBackgroundColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}">
                                                <Image Source="{x:Bind ViewModel.FrontBackgroundImage, Mode=OneWay}"
                                                       Stretch="{x:Bind GetImageStretch(ViewModel.FrontBackgroundFit), Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.HasFrontBackgroundImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>

                                            <!-- Front Elements Layer -->
                                            <Canvas x:Name="FrontElementsCanvas"
                                                    Width="{x:Bind ViewModel.CanvasWidth, Mode=OneWay}"
                                                    Height="{x:Bind ViewModel.CanvasHeight, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </StackPanel>

                            <!-- BACK CARD -->
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Text="Back Card" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="#94A3B8"
                                        Background="White">
                                    <Viewbox Width="{x:Bind GetCardDisplayWidth(ViewModel.CanvasWidth), Mode=OneWay}"
                                             Height="{x:Bind GetCardDisplayHeight(ViewModel.CanvasHeight), Mode=OneWay}"
                                             Stretch="Uniform">
                                        <Canvas x:Name="BackCanvas"
                                                Width="{x:Bind ViewModel.CanvasWidth, Mode=OneWay}"
                                                Height="{x:Bind ViewModel.CanvasHeight, Mode=OneWay}">
                                            <!-- Back Background -->
                                            <Border x:Name="BackBackgroundBorder"
                                                    Width="{x:Bind ViewModel.CanvasWidth, Mode=OneWay}"
                                                    Height="{x:Bind ViewModel.CanvasHeight, Mode=OneWay}"
                                                    Background="{x:Bind ViewModel.BackBackgroundColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}">
                                                <Image Source="{x:Bind ViewModel.BackBackgroundImage, Mode=OneWay}"
                                                       Stretch="{x:Bind GetImageStretch(ViewModel.BackBackgroundFit), Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.HasBackBackgroundImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>

                                            <!-- Back Elements Layer -->
                                            <Canvas x:Name="BackElementsCanvas"
                                                    Width="{x:Bind ViewModel.CanvasWidth, Mode=OneWay}"
                                                    Height="{x:Bind ViewModel.CanvasHeight, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
