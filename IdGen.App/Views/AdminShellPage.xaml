<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.AdminShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="AdminNavView"
                        PaneTitle="Admin Portal"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        IsBackButtonVisible="Collapsed"
                        ItemInvoked="AdminNavView_ItemInvoked"
                        Loaded="AdminNavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemRegistrations" Content="Student Registrations" Tag="Registrations" Icon="People" />
                <NavigationViewItem x:Name="NavItemSections" Content="Year &amp; Section" Tag="Sections" Icon="Folder" />
                <NavigationViewItem x:Name="NavItemDefaults" Content="School Defaults" Tag="Defaults" Icon="Setting" />
                <NavigationViewItem x:Name="NavItemDesigner" Content="ID Template Designer" Tag="Designer" Icon="Edit" />
                <NavigationViewItem x:Name="NavItemSubmissions" Content="ID Submissions" Tag="Submissions" Icon="Contact" />
                <NavigationViewItem x:Name="NavItemResets" Content="Reset Requests" Tag="Resets" Icon="Refresh" />
                <NavigationViewItem x:Name="NavItemUsers" Content="All Users" Tag="Users" Icon="ContactInfo" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Sign Out" Tag="SignOut" Icon="Back" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="AdminContentFrame" Margin="0" />
        </NavigationView>
    </Grid>
</Page>
