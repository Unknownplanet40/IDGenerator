<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.AdminSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IdGen.App.ViewModels"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="420"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32">
            <StackPanel Spacing="16">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Administrator Setup"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="First-time setup: create the system administrator credentials. No default credentials exist."
                               Style="{ThemeResource BodySubtleTextBlockStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- InfoBar for general errors -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         IsClosable="True" />

                <!-- Admin Username -->
                <StackPanel Spacing="4">
                    <TextBox Header="Admin Username"
                             Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Admin Username"
                             PlaceholderText="e.g. admin"
                             TabIndex="1" />
                    <TextBlock Text="{x:Bind ViewModel.UsernameError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.UsernameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="4">
                    <PasswordBox Header="Password (min 8 characters)"
                                 Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Admin Password"
                                 TabIndex="2" />
                    <TextBlock Text="{x:Bind ViewModel.PasswordError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.PasswordError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <!-- Confirm Password -->
                <StackPanel Spacing="4">
                    <PasswordBox Header="Confirm Password"
                                 Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Confirm Admin Password"
                                 TabIndex="3" />
                    <TextBlock Text="{x:Bind ViewModel.ConfirmPasswordError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.ConfirmPasswordError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <!-- Action Button -->
                <Button Content="Create Administrator Account"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CreateAdminCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        AutomationProperties.Name="Create Administrator Account Button"
                        TabIndex="4"
                        Margin="0,8,0,0" />

                <ProgressBar IsIndeterminate="True"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
