<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.Admin.AdminSectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdGen.Core.Models"
    xmlns:vm="using:IdGen.App.ViewModels.Admin"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,24,32,32" RowSpacing="20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Year &amp; Section Management"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Manage academic programs, year levels, sections, and assigned class advisers."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="13" />
            </StackPanel>

            <!-- Status InfoBar -->
            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.IsStatusError, Mode=OneWay, Converter={StaticResource BoolToSeverityConverter}}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="True"
                     AutomationProperties.Name="Section Action Status" />

            <!-- Add / Edit Form Card -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Course / Program -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBox Header="Course / Program"
                                     Text="{x:Bind ViewModel.Course, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. BSIT"
                                     AutomationProperties.Name="Course Input"
                                     TabIndex="1" />
                            <TextBlock Text="{x:Bind ViewModel.CourseError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       Visibility="{x:Bind ViewModel.CourseError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Year Level -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox Header="Year Level *"
                                     Text="{x:Bind ViewModel.YearLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. 3rd Year"
                                     AutomationProperties.Name="Year Level Input"
                                     TabIndex="2" />
                            <TextBlock Text="{x:Bind ViewModel.YearLevelError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       Visibility="{x:Bind ViewModel.YearLevelError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Section Name -->
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBox Header="Section Name *"
                                     Text="{x:Bind ViewModel.SectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. Section A"
                                     AutomationProperties.Name="Section Name Input"
                                     TabIndex="3" />
                            <TextBlock Text="{x:Bind ViewModel.SectionNameError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       Visibility="{x:Bind ViewModel.SectionNameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Adviser -->
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBox Header="Class Adviser *"
                                     Text="{x:Bind ViewModel.Adviser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. Prof. Juan Dela Cruz"
                                     AutomationProperties.Name="Adviser Input"
                                     TabIndex="4" />
                            <TextBlock Text="{x:Bind ViewModel.AdviserError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       Visibility="{x:Bind ViewModel.AdviserError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <Button Content="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SaveSectionCommand}"
                                    AutomationProperties.Name="Save Section Button"
                                    TabIndex="5" />

                            <Button Content="Cancel"
                                    Command="{x:Bind ViewModel.CancelEditCommand}"
                                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    AutomationProperties.Name="Cancel Edit Button"
                                    TabIndex="6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Search and Filter Bar -->
            <Grid Grid.Row="3" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="Search course, year, section, or adviser..."
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search Sections Input"
                         TabIndex="7" />
            </Grid>

            <!-- Table Card Container -->
            <Border Grid.Row="4"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="260">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Column Header -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0"
                            Padding="16,12">
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COURSE / PROGRAM" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="YEAR LEVEL" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="SECTION NAME" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="CLASS ADVISER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,40,0,40"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="No sections found"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add a new section above or clear the search filter."
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Data List -->
                    <ListView Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Sections}"
                              SelectionMode="None"
                              Padding="0"
                              Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="52" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Section">
                                <Grid Padding="16,12"
                                      HorizontalAlignment="Stretch"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Course -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Course}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <!-- Year Level -->
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind YearLevel}"
                                               VerticalAlignment="Center" />

                                    <!-- Section Name -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind SectionName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Adviser -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Adviser}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Actions: Edit and Delete -->
                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="Edit"
                                                Click="OnEditClicked"
                                                AutomationProperties.Name="Edit Section Button" />
                                        <Button Content="Delete"
                                                Click="OnDeleteClicked"
                                                AutomationProperties.Name="Delete Section Button" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
