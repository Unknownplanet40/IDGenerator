<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.Admin.AdminDefaultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IdGen.App.ViewModels.Admin"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,24,32,32" RowSpacing="20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header and Dirty State -->
            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="School &amp; Academic Defaults"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Manage institution details, academic term, signatory, and institutional logo for student ID cards."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>

                <!-- Dirty State Badge & Save Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="Unsaved Changes" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Save Settings"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveDefaultsCommand}"
                            AutomationProperties.Name="Save All Defaults Button"
                            TabIndex="10" />
                </StackPanel>
            </Grid>

            <!-- Status InfoBar -->
            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.IsStatusError, Mode=OneWay, Converter={StaticResource BoolToSeverityConverter}}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="True"
                     AutomationProperties.Name="Defaults Action Status" />

            <!-- Three Cards Stack -->
            <StackPanel Grid.Row="2" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="900">

                <!-- CARD 1: School Identity -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="School Identity" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Basic institution name, campus designation, and official logo."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <MenuFlyoutSeparator />

                        <!-- School Name -->
                        <StackPanel Spacing="4">
                            <TextBox Header="School Name *"
                                     Text="{x:Bind ViewModel.SchoolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. Apex Institute of Science &amp; Technology"
                                     AutomationProperties.Name="School Name Input"
                                     TabIndex="1" />
                            <TextBlock Text="{x:Bind ViewModel.SchoolNameError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       Visibility="{x:Bind ViewModel.SchoolNameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Campus Name -->
                        <StackPanel Spacing="4">
                            <TextBox Header="Campus Name (Optional)"
                                     Text="{x:Bind ViewModel.CampusName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. Metropolitan Campus"
                                     AutomationProperties.Name="Campus Name Input"
                                     TabIndex="2" />
                            <TextBlock Text="{x:Bind ViewModel.CampusNameError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       Visibility="{x:Bind ViewModel.CampusNameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- School Logo Upload & Preview -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Official School Logo (Max 2MB, PNG or JPG)"
                                       FontWeight="Medium"
                                       FontSize="13" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Logo Preview Box -->
                                <Border Grid.Column="0"
                                        Width="100"
                                        Height="100"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                    <Grid>
                                        <Image Source="{x:Bind ViewModel.LogoImage, Mode=OneWay}"
                                               Stretch="Uniform"
                                               Visibility="{x:Bind ViewModel.HasLogo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                                                    Visibility="{x:Bind ViewModel.HasLogo, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="No Logo" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Upload / Remove Buttons -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{x:Bind ViewModel.UploadLogoCommand}"
                                                AutomationProperties.Name="Upload Logo Button"
                                                TabIndex="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                                <TextBlock Text="Upload Logo" />
                                            </StackPanel>
                                        </Button>

                                        <Button Content="Remove"
                                                Command="{x:Bind ViewModel.RemoveLogoCommand}"
                                                Visibility="{x:Bind ViewModel.HasLogo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="Remove Logo Button"
                                                TabIndex="4" />
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind ViewModel.LogoError, Mode=OneWay}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               FontSize="12"
                                               Visibility="{x:Bind ViewModel.LogoError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Authorized Signatory -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Authorized Signatory" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Campus administrator or university president signing the student ID card."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Signatory Name -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBox Header="Signatory Name *"
                                         Text="{x:Bind ViewModel.PrincipalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. Dr. Eleanor M. Vance"
                                         AutomationProperties.Name="Signatory Name Input"
                                         TabIndex="5" />
                                <TextBlock Text="{x:Bind ViewModel.PrincipalNameError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12"
                                           Visibility="{x:Bind ViewModel.PrincipalNameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Signatory Title -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBox Header="Signatory Title *"
                                         Text="{x:Bind ViewModel.PrincipalTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. University President / Registrar"
                                         AutomationProperties.Name="Signatory Title Input"
                                         TabIndex="6" />
                                <TextBlock Text="{x:Bind ViewModel.PrincipalTitleError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12"
                                           Visibility="{x:Bind ViewModel.PrincipalTitleError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 3: Academic Term -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Academic Term" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Current active semester and academic school year stamped onto new ID cards."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Semester -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Semester *" FontWeight="Medium" FontSize="14" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.SemesterOptions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSemester, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Semester Selector"
                                          TabIndex="7" />
                                <TextBlock Text="{x:Bind ViewModel.SemesterError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12"
                                           Visibility="{x:Bind ViewModel.SemesterError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- School Year -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBox Header="School Year * (YYYY-YYYY)"
                                         Text="{x:Bind ViewModel.SchoolYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. 2024-2025"
                                         AutomationProperties.Name="School Year Input"
                                         TabIndex="8" />
                                <TextBlock Text="{x:Bind ViewModel.SchoolYearError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12"
                                           Visibility="{x:Bind ViewModel.SchoolYearError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
