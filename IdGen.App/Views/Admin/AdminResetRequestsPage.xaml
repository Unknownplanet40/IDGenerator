<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.Admin.AdminResetRequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdGen.Core.Models"
    xmlns:vm="using:IdGen.App.ViewModels.Admin"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,24" RowSpacing="16" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header & Filter -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Reset ID Requests"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Review student requests to reset their submitted ID form. Approving unlocks their ID generator."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>

                <!-- Filter Toggle (Pending vs All) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="BtnFilterPending"
                            Content="Pending"
                            Click="OnFilterPendingClicked"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.Name="Filter Pending Reset Requests" />
                    <Button x:Name="BtnFilterAll"
                            Content="All History"
                            Click="OnFilterAllClicked"
                            AutomationProperties.Name="Filter All Reset Requests" />
                </StackPanel>
            </Grid>

            <!-- Status InfoBar -->
            <InfoBar Grid.Row="1"
                     IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.IsStatusError, Mode=OneWay, Converter={StaticResource BoolToSeverityConverter}}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="True"
                     AutomationProperties.Name="Reset Request Action Status" />

            <!-- Table Card Container -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="300">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Column Header -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0"
                            Padding="16,12">
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="REQUEST #" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="STUDENT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="REQUESTED AT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="RESOLVED AT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="" />
                            <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,48,0,48"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE72C;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="No ID reset requests"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="When students submit reset requests, they will appear here for review."
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Data List -->
                    <ListView Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.ResetRequests}"
                              SelectionMode="None"
                              Padding="0"
                              Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="52" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ResetRequest">
                                <Grid Padding="16,12"
                                      HorizontalAlignment="Stretch"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Request ID -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Id}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <!-- Student Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind StudentNoDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind StudentNameDisplay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Requested Date -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind RequestedAtDisplay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Resolved Date -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind ResolvedAtDisplay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Status Badge -->
                                    <Border Grid.Column="4"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Status}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <Grid Grid.Column="5" />

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="6"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="Approve"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Click="OnApproveClicked"
                                                IsEnabled="{x:Bind IsPending, Mode=OneTime}"
                                                Visibility="{x:Bind IsPending, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="Approve Reset Request Button" />
                                        <Button Content="Decline"
                                                Click="OnDeclineClicked"
                                                IsEnabled="{x:Bind IsPending, Mode=OneTime}"
                                                Visibility="{x:Bind IsPending, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="Decline Reset Request Button" />
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                Visibility="{x:Bind IsPending, Mode=OneTime, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <TextBlock Text="Resolved" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
