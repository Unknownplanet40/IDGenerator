<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.Admin.AdminUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdGen.Core.Models"
    xmlns:vm="using:IdGen.App.ViewModels.Admin"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,24" RowSpacing="16" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="System Users"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Directory of all registered administrators and students in the system."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="1"
                        Click="OnRefreshClicked"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Refresh User List Button">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filter & Search Bar -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         PlaceholderText="Search by name, student no, username, email..."
                         TextChanged="OnSearchTextChanged"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Search Users Input">
                    <TextBox.Header>
                        <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBox.Header>
                </TextBox>

                <!-- Role Filter -->
                <ComboBox x:Name="RoleCombo"
                          Grid.Column="1"
                          Header="Role"
                          SelectedIndex="0"
                          SelectionChanged="OnRoleFilterChanged"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Filter Users By Role">
                    <ComboBoxItem Content="All Roles" Tag="All" />
                    <ComboBoxItem Content="Admins" Tag="Admin" />
                    <ComboBoxItem Content="Students" Tag="Student" />
                </ComboBox>

                <!-- Status Filter -->
                <ComboBox x:Name="StatusCombo"
                          Grid.Column="2"
                          Header="Status"
                          SelectedIndex="0"
                          SelectionChanged="OnStatusFilterChanged"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Filter Users By Status">
                    <ComboBoxItem Content="All Statuses" Tag="All" />
                    <ComboBoxItem Content="Approved" Tag="Approved" />
                    <ComboBoxItem Content="Pending" Tag="Pending" />
                    <ComboBoxItem Content="Declined" Tag="Declined" />
                </ComboBox>

                <!-- Summary Counter -->
                <TextBlock Grid.Column="3"
                           Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,8" />
            </Grid>

            <!-- Status InfoBar -->
            <InfoBar Grid.Row="2"
                     IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.IsStatusError, Mode=OneWay, Converter={StaticResource BoolToSeverityConverter}}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="True"
                     AutomationProperties.Name="User Management Status" />

            <!-- Table Card Container -->
            <Border Grid.Row="3"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="360">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Column Header -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0"
                            Padding="16,12">
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="135" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ID" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="STUDENT NO" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="FULL NAME" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="USERNAME" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="ROLE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="6" Text="CONTACT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="7" Text="REGISTERED" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,56,0,56"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="No users found"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="No user accounts match the selected role, status, or search query."
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Data List -->
                    <ListView Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.FilteredUsers}"
                              SelectionMode="None"
                              Padding="0"
                              Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="56" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:User">
                                <Grid Padding="16,12"
                                      HorizontalAlignment="Stretch"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="135" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ID -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Id, Mode=OneTime}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <!-- Student No -->
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind StudentNoDisplay, Mode=OneTime}"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />

                                    <!-- Full Name -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind FullName, Mode=OneTime}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Username -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Username, Mode=OneTime}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Role Badge -->
                                    <Border Grid.Column="4"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind RoleDisplay, Mode=OneTime}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="5"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind StatusDisplay, Mode=OneTime}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Contact Info (Email & Phone) -->
                                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Email, Mode=OneTime}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Phone, Mode=OneTime}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Registered Date -->
                                    <TextBlock Grid.Column="7"
                                               Text="{x:Bind CreatedAtDisplay, Mode=OneTime}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
