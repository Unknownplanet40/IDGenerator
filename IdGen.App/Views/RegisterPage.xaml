<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IdGen.App.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IdGen.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="560"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32">
                <StackPanel Spacing="16">
                    <!-- Title & Header -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Student Registration"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Register a new student account. Registration requires administrator approval."
                                   Style="{ThemeResource BodySubtleTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Status Notifications -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                             Severity="Error"
                             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             IsClosable="True"
                             AutomationProperties.Name="Registration Error Alert" />

                    <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                             Severity="Success"
                             Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                             IsClosable="False"
                             AutomationProperties.Name="Registration Success Alert" />

                    <!-- Student ID Number -->
                    <StackPanel Spacing="4">
                        <TextBox Header="Student ID Number *"
                                 Text="{x:Bind ViewModel.StudentNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Student ID Number"
                                 PlaceholderText="e.g. 202110055"
                                 MaxLength="10"
                                 TabIndex="1" />
                        <TextBlock Text="{x:Bind ViewModel.StudentNoError, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Visibility="{x:Bind ViewModel.StudentNoError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Name Fields (First, Middle, Last) in 3 Columns -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- First Name -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBox Header="First Name *"
                                     Text="{x:Bind ViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="First Name"
                                     TabIndex="2" />
                            <TextBlock Text="{x:Bind ViewModel.FirstNameError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.FirstNameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Middle Name -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox Header="Middle Name"
                                     Text="{x:Bind ViewModel.MiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Middle Name"
                                     TabIndex="3" />
                            <TextBlock Text="{x:Bind ViewModel.MiddleNameError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.MiddleNameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Last Name -->
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBox Header="Last Name *"
                                     Text="{x:Bind ViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Last Name"
                                     TabIndex="4" />
                            <TextBlock Text="{x:Bind ViewModel.LastNameError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.LastNameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Email & Phone in 2 Columns -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Email -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBox Header="Email Address *"
                                     Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Email Address"
                                     PlaceholderText="student@example.edu"
                                     TabIndex="5" />
                            <TextBlock Text="{x:Bind ViewModel.EmailError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.EmailError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox Header="Phone Number (PH) *"
                                     Text="{x:Bind ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Phone Number"
                                     PlaceholderText="09XXXXXXXXX"
                                     TabIndex="6" />
                            <TextBlock Text="{x:Bind ViewModel.PhoneError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.PhoneError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Username -->
                    <StackPanel Spacing="4">
                        <TextBox Header="Username *"
                                 Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Username"
                                 PlaceholderText="Choose a username"
                                 TabIndex="7" />
                        <TextBlock Text="{x:Bind ViewModel.UsernameError, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Visibility="{x:Bind ViewModel.UsernameError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Passwords in 2 Columns -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Password -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <PasswordBox Header="Password (min 8 chars) *"
                                         Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Password"
                                         TabIndex="8" />
                            <TextBlock Text="{x:Bind ViewModel.PasswordError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.PasswordError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Confirm Password -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <PasswordBox Header="Confirm Password *"
                                         Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Confirm Password"
                                         TabIndex="9" />
                            <TextBlock Text="{x:Bind ViewModel.ConfirmPasswordError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.ConfirmPasswordError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Register Action Button -->
                    <Button Content="Submit Registration"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RegisterCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            AutomationProperties.Name="Submit Registration Button"
                            TabIndex="10"
                            Margin="0,8,0,0" />

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Back to Login Link -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Already registered?"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource BodyTextBlockStyle}" />
                        <HyperlinkButton Content="Back to Sign In"
                                         Command="{x:Bind ViewModel.GoToLoginCommand}"
                                         AutomationProperties.Name="Back to Sign In Link"
                                         TabIndex="11" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
